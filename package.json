{
  "name": "ruslan-nazarov-research",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "validate": "node scripts/validate-content.mjs",
    "build": "npm run validate && node scripts/astro.mjs build && pagefind --site dist && node scripts/verify-build.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:features": "node scripts/test-feature-fixtures.mjs",
    "test:media": "node scripts/test-media-fixtures.mjs",
    "content:release": "node scripts/release-content.mjs",
    "graph:import": "node scripts/import-graph.mjs",
    "editor": "node scripts/local-editor.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@xyflow/react": "^12.9.0",
    "astro": "^7.4.1",
    "katex": "^0.19.0",
    "pagefind": "^1.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.35.5",
    "unified": "^11.0.5",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.56.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "katex": "$katex"
  }
}
