---
import Base from '../../layouts/Base.astro';
import Home from '../../components/Home.astro';
import Catalog from '../../components/Catalog.astro';
import Contact from '../../components/Contact.astro';
import MediaBody from '../../components/MediaBody.astro';
import {mediaForPath} from '../../lib/media.mjs';
import ResearchGraph from '../../components/graph/ResearchGraph';
import {allContent,routes,site,readJSON,localize as l,pathFor,events} from '../../lib/content.mjs';
import {markdown} from '../../lib/markdown.mjs';
import {getPublicGraph,getDemoGraph} from '../../lib/graph.mjs';
export function getStaticPaths(){return ['ru','en'].flatMap(lang=>routes().map(path=>({params:{lang,path:path||undefined}})))}
const lang=Astro.params.lang as 'ru'|'en';
const path=Astro.params.path||'';
const t=readJSON('src/data/ui.json')[lang],s=site[lang],data=allContent() as Record<string,any[]>;
const sections=path.split('/'),section=sections[0];
const graph=path==='projects/mathematical-parser/graph',full=path==='publications/theses-2020-2026/full';
const row=Object.entries(data).flatMap(([collection,rows])=>rows.map(r=>({...r,collection}))).find(r=>pathFor(r.collection,r,lang)===`/${lang}/${path}/`);
const title=path===''?s.role:graph?t.graph:full?l(data.publications.find(r=>r.id==='theses-2020-2026'),'title',lang):row?l(row,'title',lang):section==='about'?s.aboutTitle:t[section];
const description=row?l(row,'summary',lang):graph?t.graphDescription:section==='timeline'?t.timelineDescription:s.heroText;
const chapters=data.theses.slice().sort((a,b)=>(a.order||0)-(b.order||0));
const thesis=data.publications.find(r=>r.id==='theses-2020-2026');
const date=(value:string)=>new Intl.DateTimeFormat(lang==='ru'?'ru-RU':'en-GB',{dateStyle:'long',timeZone:'UTC'}).format(new Date(value+'T12:00:00Z'));
const related=(name:string)=>data[name].filter(r=>row&&(row[name==='projects'?'relatedProjects':name==='publications'?'relatedPublications':'relatedJournal']?.includes(r.id)||row.collection==='research'&&r.researchAreas.includes(row.id)||row.collection==='projects'&&r.relatedProjects?.includes(row.id)));
---
<Base lang={lang} title={title} description={description} path={path} noindex={section==='search'}>
  {path===''?<Home lang={lang} data={data}/>:<>
    <div class:list={['wrap','page-intro',graph&&'graph-intro']}>
      <nav class="breadcrumbs" aria-label={t.back}><a href={`/${lang}/`}>{t.home}</a><span>/</span>{sections.length>1?<><a href={`/${lang}/${section}/`}>{t[section]}</a><span>/</span><span>{title}</span></>:<span>{title}</span>}</nav>
      <p class="eyebrow">{row?.byline_ru?l(row,'byline',lang):row?.type?t[row.type]:graph?t.parserLabel:site.tagline}</p>
      <h1>{title}</h1>
      {row?.motto_ru&&<p class="papanda-motto"><strong>{l(row,'motto',lang)}</strong></p>}
      {row&&<p class="page-description">{l(row,'summary',lang)}</p>}
      {graph&&<p class="page-description">{t.graphDescription}</p>}
      {section==='timeline'&&<p class="page-description">{t.timelineDescription}</p>}
    </div>
    {graph?<div class="wrap graph-page" data-pagefind-ignore><ResearchGraph lang={lang} t={t} publicData={getPublicGraph()} demoData={getDemoGraph()} client:load/><noscript><p>{t.nodeList}: {t.noApproved}</p></noscript></div>
    :full?<div class="wrap reading-layout">
      <aside class="toc"><h2>{t.contents}</h2>{chapters.map((c:any)=><a href={`#chapter-${c.id}`}>{c.order}. {l(c,'title',lang)}</a>)}<a href={`/${lang}/publications/theses-2020-2026/`}>{t.back} ↗</a></aside>
      <article class="prose"><div class="notice">{l(thesis,'summary',lang)}</div><MediaBody text={l(thesis,'body',lang)} lang={lang} prose={false}/>{chapters.map(c=><section id={`chapter-${c.id}`}><h2>{c.order}. {l(c,'title',lang)}</h2><p class="muted">{l(c,'summary',lang)}</p>{c.editorialStatus==='final'&&l(c,'body',lang)?<MediaBody text={l(c,'body',lang)} lang={lang} prose={false}/>:<p class="notice">{t.chapterPending}</p>}<a href={pathFor('theses',c,lang)}>{t.read} ↗</a></section>)}</article>
    </div>
    :row?<div class="wrap detail-layout">
      <article>
        {row.heroImage&&<figure><a href={row.heroImage} data-media-viewer><img class="detail-hero-image" src={row.heroImage} alt={l(mediaForPath(row.heroImage)||{},'alt',lang)||title}/></a>{mediaForPath(row.heroImage)&&<figcaption>{l(mediaForPath(row.heroImage),'caption',lang)}</figcaption>}</figure>}
        {row.editorialStatus==='awaiting_content'&&row.collection!=='theses'&&<p class="editorial-note">{t.editorial}</p>}
        {row.collection==='theses'&&row.editorialStatus!=='final'?<p class="notice">{t.chapterPending}</p>:<MediaBody text={l(row,'body',lang)} lang={lang}/>}
        {row.exampleLinks?.some((link:any)=>link[`url_${lang}`])&&<ul class="example-links">{row.exampleLinks.filter((link:any)=>link[`url_${lang}`]).map((link:any)=><li><a href={link[`url_${lang}`]}>{l(link,'label',lang)} ↗</a></li>)}</ul>}
        {row.collection==='research'&&<>
          <section class="detail-section"><h2>{t.questions}</h2><ul class="question-list">{l(row,'questions',lang).split('\n').filter(Boolean).map((q:string)=><li>{q}</li>)}</ul></section>
          <section class="detail-section"><h2>{t.openProblems}</h2><p>{l(row,'openProblems',lang)}</p></section>
        </>}
        {row.id==='mathematical-parser'&&<a class="button" href={`/${lang}/projects/mathematical-parser/graph/`}>{getPublicGraph().nodes.length?t.openGraph:t.demoGraph} ↗</a>}
        {row.id==='papanda'&&data.pages.some(p=>p.slug==='dialectical-notes')&&<a class="button" href={`/${lang}/projects/papanda/dialectical-notes/`}>{t.notes} ↗</a>}
        {row.id==='theses-2020-2026'&&<>
          <div class="thesis-toolbar"><a class="button" href={`/${lang}/publications/theses-2020-2026/full/`}>{t.fullText} ↗</a>{row[`pdf_${lang}`]&&<a class="button secondary" href={row[`pdf_${lang}`]}>PDF {lang.toUpperCase()} ↓</a>}</div>
          <section class="detail-section"><h2>{t.contents}</h2><div class="chapter-list">{chapters.map((c:any)=><a href={pathFor('theses',c,lang)}><span class="mono">0{c.order}</span><div><h3>{l(c,'title',lang)}</h3><p>{l(c,'summary',lang)}</p></div><span>↗</span></a>)}</div></section>
        </>}
        {(row.collection==='projects'&&!/\[\[media:[a-z0-9-]+\]\]/.test(l(row,'body',lang)))||row.gallery.length>0?<section class="detail-section"><h2>{t.gallery}</h2>{row.gallery.length?<div class="gallery">{row.gallery.map((img:any)=><figure><a href={img.src} data-media-viewer><img loading="lazy" src={img.src} alt={l(mediaForPath(img.src)||{},'alt',lang)||l(img,'alt',lang)}/></a><figcaption>{l(mediaForPath(img.src)||{},'caption',lang)||l(img,'alt',lang)}</figcaption></figure>)}</div>:<div class="media-placeholder"><span aria-hidden="true">▧</span><p>{t.galleryEmpty}</p></div>}</section>:null}
        {['projects','publications','journal'].map(name=>{
          const items=related(name).filter(r=>r.id!==row.id);
          return items.length>0?<section class="detail-section"><h2>{t[name==='journal'?'thematicJournal':name==='projects'?'relatedProjects':'relatedPublications']}</h2><div class="related-list">{items.map(item=><a href={pathFor(name,item,lang)}><strong>{l(item,'title',lang)}</strong><span>↗</span></a>)}</div></section>:null;
        })}
        {row.collection==='research'&&<section class="detail-section">{related('journal').length===0&&<><h2>{t.thematicJournal}</h2><p class="muted">{s.journalEmpty}</p></>}<a class="text-link" href={`/${lang}/research/${row.slug}/rss.xml`}>{t.rss} ↗</a></section>}
        {(row.timeline.length>0||row.collection==='research')&&<section class="detail-section"><h2>{t.timeline}</h2>{events(data).filter(e=>row.collection==='research'?e.row.researchAreas.includes(row.id):e.row.id===row.id).length?events(data).filter(e=>row.collection==='research'?e.row.researchAreas.includes(row.id):e.row.id===row.id).map(e=><p><time datetime={e.date}>{date(e.date)}</time> — {l(e,'title',lang)}</p>):<p class="muted">{t.noRelated}</p>}</section>}
      </article>
      <aside class="detail-sidebar">
        {row.status&&<div><span class="eyebrow">{t.status}</span><p><span class="badge"><span class="status-dot"></span>{l(row,'statusLabel',lang)||t[row.status]}</span></p></div>}
        {row.date&&<time datetime={row.date}>{date(row.date)}</time>}
        {row.targetDate&&<div><span class="eyebrow">{t.planned}</span><p>{date(row.targetDate)}</p></div>}
        {row.researchAreas.length>0&&<div><span class="eyebrow">{t.research}</span>{row.researchAreas.map((id:string)=>data.research.find(r=>r.id===id)).filter(Boolean).map((r:any)=><a href={pathFor('research',r,lang)}>{l(r,'title',lang)} ↗</a>)}</div>}
        {row.links.length>0&&<div class="external-links">{row.links.map((link:any)=><a class="button secondary" href={link.url} rel="noopener noreferrer">{l(link,'label',lang)} ↗</a>)}</div>}
        {row.license&&<div><span class="eyebrow">{t.originalLicense}</span><p>{row.license}</p></div>}
        {row.collection==='theses'&&<a href={`/${lang}/publications/theses-2020-2026/full/#chapter-${row.id}`}>{t.fullText} ↗</a>}
        <div class="tag-list">{row.tags.map((tag:string)=><span>{t['tag:'+tag]||tag}</span>)}</div>
      </aside>
    </div>
    :section==='research'?<section class="wrap section"><div class="research-grid">{data.research.map((r:any,i:number)=><a class="research-tile" href={pathFor('research',r,lang)}><div class="research-tile-top"><span class="research-symbol">{r.symbol}</span><span class="mono">0{i+1}</span></div><h2>{l(r,'title',lang)}</h2><p>{l(r,'summary',lang)}</p><span class="tile-arrow">↗</span></a>)}</div><p class="method-note">{s.heroNote}</p></section>
    :['projects','publications','journal'].includes(section)?<div class="wrap catalog-section">{section==='journal'&&<div class="journal-heading">{!data.journal.length&&<p>{s.journalEmpty}</p>}<a href={`/${lang}/rss.xml`}>{t.rss} ↗</a></div>}<Catalog rows={section==='journal'?data.journal.slice().sort((a,b)=>b.date.localeCompare(a.date)):data[section]} collection={section} lang={lang} research={data.research}/></div>
    :section==='about'?<div class="wrap about-layout"><div><div class="prose" set:html={await markdown(s.aboutBody)}/><section id="contact" class="detail-section"><h2>{s.contactTitle}</h2><p>{s.contactText}</p><Contact lang={lang}/></section></div><aside class="about-portrait">{site.portrait?<img src={site.portrait} alt={site.name}/>:<div class="monogram large">rn<span>·</span></div>}<span class="mono">{site.name}</span>{!site.portrait&&<p class="small muted">{t.portrait}</p>}</aside></div>
    :section==='timeline'?<div class="wrap timeline-page"><div class="history-block"><span class="mono">2020 — 2025</span><div><h2>{t.history}</h2><p>{s.history}</p></div></div><h2>2026 —</h2><Catalog rows={events(data).filter(e=>e.date>='2026-01-01').map(e=>({...e.row,slug:e.row.slug,title_ru:e.title_ru,title_en:e.title_en,summary_ru:date(e.date)+' · '+l(e.row,'summary','ru'),summary_en:date(e.date)+' · '+l(e.row,'summary','en'),eventCollection:e.collection}))} collection="timeline" lang={lang} research={data.research}/>{thesis?.targetDate&&<section class="planned-block"><span class="eyebrow">{t.upcoming}</span><h2>{date(thesis.targetDate)} · {l(thesis,'title',lang)}</h2><p>{t.upcomingNote}</p><a href={`/${lang}/publications/theses-2020-2026/`}>{t.read} ↗</a></section>}</div>
    :section==='search'?<section class="wrap search-page" data-pagefind-ignore><p>{t.searchHint}</p><div id="search" data-language={lang} data-unavailable={t.searchUnavailable}><p role="status">{t.searchLoading}</p></div><link rel="stylesheet" href="/pagefind/pagefind-ui.css"/><script>
      const container=document.querySelector<HTMLElement>('#search');
      if(container){
        const script=document.createElement('script');script.src='/pagefind/pagefind-ui.js';
        script.onload=()=>{container.innerHTML='';const Constructor=(window as any).PagefindUI;new Constructor({element:'#search',showSubResults:true,showImages:false,pageSize:8,bundlePath:'/pagefind/',translations:container.dataset.language==='ru'?{placeholder:'Поиск по сайту',zero_results:'Ничего не найдено для [SEARCH_TERM]',searching:'Поиск…',clear_search:'Очистить',load_more:'Показать ещё',search_label:'Поиск',many_results:'Найдено: [COUNT]',one_result:'Найдено: 1'}:{}})};
        script.onerror=()=>{container.textContent=container.dataset.unavailable!};document.head.append(script);
      }
    </script></section>
    :section==='legal'||section==='privacy'?<section class="wrap prose legal-page"><p>{section==='legal'?s.rights:s.privacy}</p>{section==='legal'?<><p>{t.codeLicense}</p><a href="https://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution 4.0 ↗</a></>:<p>{site.cloudflareToken?t.analyticsOn:t.analyticsOff}</p>}</section>:null}
  </>}
</Base>
