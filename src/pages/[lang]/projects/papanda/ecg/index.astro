---
import Base from '../../../../../layouts/Base.astro';
import originalRu from '../../../../../data/ecg-showcase/ru-original.json';
import originalEn from '../../../../../data/ecg-showcase/en-original.json';
import finalRu from '../../../../../data/ecg-showcase/ru-final.json';
import finalEn from '../../../../../data/ecg-showcase/en-final.json';
import '../../../../../styles/ecg-showcase.css';

export function getStaticPaths() {
  return [{params:{lang:'ru'}},{params:{lang:'en'}}];
}
const lang=Astro.params.lang as 'ru'|'en';
const ru=lang==='ru';
const original=ru?originalRu:originalEn;
const revised=ru?finalRu:finalEn;
const path='projects/papanda/ecg';
const firstCritique=original.blocks.flatMap((block:any)=>block.rejected_drafts||[]).find((draft:any)=>draft.reason?.trim());
const annotationCount=original.blocks.reduce((sum:number,block:any)=>sum+(block.inline_notes?.length||0),0);
const heading=ru?'Как собрать одноканальный ЭКГ?':'How to Build a Single-Channel ECG Device';
---
<Base lang={lang} path={path} title={heading} description={ru?'Статический пример диалектического конспекта: первоначальный вариант с критикой и переработанный конспект.':'A static dialectical-notes example: the initial annotated version and revised notes.'}>
  <div class="wrap ecg-wrap">
    <nav class="breadcrumbs" aria-label={ru?'Навигация':'Breadcrumbs'}><a href={`/${lang}/`}>{ru?'Главная':'Home'}</a><span>/</span><a href={`/${lang}/projects/papanda/`}>papanda</a><span>/</span><span aria-current="page">{ru?'Пример конспекта':'Notes example'}</span></nav>
    <header class="ecg-hero">
      <p class="eyebrow">papanda · {ru?'пример конспекта':'notes example'}</p>
      <h1>{heading}</h1>
      <p>{ru?'Две версии одного исследования показывают, как первоначальный ответ ИИ становится материалом для авторской проверки и переработки.':'Two versions of the same inquiry show how an initial AI response becomes material for critical review and revision.'}</p>
      <p class="ecg-archive-note">{ru?'Сохранённые публикации доступны прямо на этом сайте и не зависят от сервера приложения. Это версии для чтения; они не позволяют редактировать конспект.':'These preserved publications are hosted on this website and do not depend on the application server. They are reading copies and cannot be edited.'}</p>
      <div class="ecg-actions"><a class="button" href={`/${lang}/${path}/original/`}>{ru?'Читать первоначальный конспект':'Read initial notes'} ↗</a><a class="button secondary" href={`/${lang}/${path}/final/`}>{ru?'Читать итоговый конспект':'Read revised notes'} ↗</a></div>
    </header>
    <section class="ecg-journey" aria-label={ru?'Этапы примера':'Stages of the example'}>
      <article><span class="ecg-number">01</span><h2>{ru?'Исходный ответ ИИ':'Initial AI response'}</h2><p>{ru?'Отправной материал для проверки. Отдельный PDF сохранён вместе с примером.':'The starting material for review. Its PDF is preserved with this example.'}</p><a href={`/assets/ecg/original-ai-${lang}.pdf`}>{ru?'Открыть PDF':'Open PDF'} ↗</a></article>
      <article><span class="ecg-number">02</span><h2>{ru?'Конспект с замечаниями':'Annotated notes'}</h2><p>{ru?`В ${original.blocks.length} блоках сохранены пометки, вопросы, стикеры и отвергнутые формулировки.`:`The ${original.blocks.length} blocks retain comments, questions, stickers and rejected formulations.`}</p><a href={`/${lang}/${path}/original/`}>{ru?'Читать с замечаниями':'Read with annotations'} ↗</a></article>
      <article><span class="ecg-number">03</span><h2>{ru?'Переработанный конспект':'Revised notes'}</h2><p>{ru?`Версия из ${revised.blocks.length} блоков показывает структуру после критического пересмотра.`:`The ${revised.blocks.length}-block version shows the structure after critical revision.`}</p><a href={`/${lang}/${path}/final/`}>{ru?'Читать итоговую версию':'Read revised version'} ↗</a></article>
    </section>
    <section id="critique" class="ecg-critique">
      <p class="eyebrow">{ru?'Что видно в самом конспекте':'What the notes show'}</p>
      <h2>{ru?'Критика сохранена рядом с ходом мысли':'The critique stays beside the reasoning'}</h2>
      <p>{ru?`В первоначальном конспекте ${annotationCount} встроенных замечаний и вопросов. К отдельным блокам прикреплены стикеры и отвергнутые варианты. Читатель может открыть их там, где возникло сомнение, и затем перейти к переработанной версии.`:`The initial notes contain ${annotationCount} inline remarks and questions. Individual blocks also carry stickers and rejected drafts. Readers can inspect a concern where it arose, then move to the revised version.`}</p>
      {firstCritique&&<blockquote><p>{firstCritique.reason}</p><cite>{ru?'Один из сохранённых авторских комментариев к отвергнутому варианту':'One preserved author comment on a rejected draft'}</cite></blockquote>}
      <div class="ecg-actions"><a class="button secondary" href={`/${lang}/${path}/original/`}>{ru?'Посмотреть замечания в контексте':'See annotations in context'} ↗</a></div>
    </section>
    <section class="ecg-resources"><h2>{ru?'Исходные материалы':'Source materials'}</h2><ul><li><a href={`/assets/ecg/original-ai-${lang}.pdf`}>{ru?'Первоначальный ответ ИИ (PDF)':'Initial AI response (PDF)'}</a></li><li><a href={`/assets/ecg/technical-requirements-${lang}.${ru?'docx':'pdf'}`}>{ru?'Техническое задание (DOCX)':'Technical requirements (PDF)'}</a></li></ul></section>
  </div>
</Base>
