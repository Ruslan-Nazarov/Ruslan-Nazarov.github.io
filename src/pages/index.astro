---
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/simple.css';
import BrandHead from '../components/BrandHead.astro';
import BrandMark from '../components/BrandMark.astro';
import {site,readJSON} from '../lib/content.mjs';
const ui=readJSON('src/data/ui.json');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><BrandHead/><title>{site.en.brandName} | {site.en.role}</title><meta name="description" content={site.en.heroText}/><link rel="canonical" href="https://ruslan-nazarov.github.io/"/><link rel="alternate" hreflang="ru" href="https://ruslan-nazarov.github.io/ru/"/><link rel="alternate" hreflang="en" href="https://ruslan-nazarov.github.io/en/"/><link rel="alternate" hreflang="x-default" href="https://ruslan-nazarov.github.io/"/><meta property="og:title" content={site.en.brandName+' | '+site.en.role}/><meta property="og:description" content={site.en.heroText}/><meta property="og:type" content="website"/><meta property="og:url" content={Astro.site}/><meta property="og:image" content={new URL(site.socialImage,Astro.site)}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={site.en.brandName+' — '+site.en.role}/><meta name="twitter:card" content="summary_large_image"/></head><body><main class="language-landing"><BrandMark id="landing-amber"/><h1>{site.en.brandName}</h1><p>{site.en.role}</p><p>{site.tagline}</p><div class="hero-actions"><a class="button" href="/ru/" lang="ru" data-language="ru">{ui.ru.languageName} →</a><a class="button secondary" href="/en/" lang="en" data-language="en">{ui.en.languageName} →</a></div></main><script is:inline>
  if(!/bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent)){
    let lang;try{lang=localStorage.getItem('rn-language')}catch{}
    if(lang!=='ru'&&lang!=='en')lang=(navigator.language||'en').toLowerCase().startsWith('ru')?'ru':'en';
    location.replace('/'+lang+'/'+location.search+location.hash);
  }
</script></body></html>
