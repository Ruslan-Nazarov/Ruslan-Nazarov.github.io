---
import '../styles/global.css';
import {site,readJSON} from '../lib/content.mjs';
const ui=readJSON('src/data/ui.json');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex"/><title>404 — {site.name}</title></head><body><main class="language-landing"><span class="eyebrow">404</span><h1>{ui.en.notFound}</h1><p lang="ru">{ui.ru.notFound}</p><p>{ui.en.notFoundText}</p><p lang="ru">{ui.ru.notFoundText}</p><div class="hero-actions"><a class="button" href="/ru/" lang="ru">{ui.ru.returnHome} →</a><a class="button secondary" href="/en/">{ui.en.returnHome} →</a></div></main></body></html>
