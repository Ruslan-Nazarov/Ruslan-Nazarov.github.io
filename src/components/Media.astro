---
import {resolveMedia} from '../lib/media.mjs';
import {readJSON} from '../lib/content.mjs';
interface Props {id:string;lang:'ru'|'en'}
const {id,lang}=Astro.props;
const t=readJSON('src/data/ui.json')[lang];
const media=resolveMedia(id),alt=media[`alt_${lang}`]||'',caption=media[`caption_${lang}`]||'';
---
<figure class="project-media" data-media-id={id}>
  {media.path?<a href={media.path} data-media-viewer aria-label={t.openImage+' '+alt}><img src={media.path} alt={alt} loading="lazy"/></a>:<div class="media-placeholder" role="img" aria-label={alt}><span aria-hidden="true">▧</span><p>{t.illustrationPending}</p><small>{alt}</small></div>}
  <figcaption>{caption}</figcaption>
</figure>
