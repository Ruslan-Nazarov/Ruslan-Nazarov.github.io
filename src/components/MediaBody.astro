---
import Media from './Media.astro';
import {markdown} from '../lib/markdown.mjs';
const {text,lang,prose=true,headingPrefix='section-',showContents=true}=Astro.props;
const headings:{id:string;title:string;level:number}[]=[];
const parts=[];
for(const part of text.split(/(\[\[media:[a-z0-9-]+\]\])/g)){
  const match=part.match(/^\[\[media:([a-z0-9-]+)\]\]$/);
  parts.push(match?{id:match[1]}:{html:await markdown(part,{headings,headingPrefix})});
}
---
{showContents&&headings.filter(h=>h.level===2).length>=4&&<nav class="article-contents" aria-label={lang==='ru'?'На этой странице':'On this page'} data-pagefind-ignore><strong>{lang==='ru'?'На этой странице':'On this page'}</strong><ol>{headings.filter(h=>h.level===2).map(h=><li><a href={`#${h.id}`}>{h.title}</a></li>)}</ol></nav>}
<div class={prose?'prose':undefined}>{parts.map(part=>'id' in part?<Media id={part.id} lang={lang}/>:<div set:html={part.html}/>)}</div>
