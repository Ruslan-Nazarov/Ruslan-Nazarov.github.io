---
import {materialHref} from '../lib/page-materials.mjs';
import Text from './Text.astro';
import {publicationDate} from '../lib/article-categories.mjs';
import {localize as l,readJSON} from '../lib/content.mjs';
import {mediaForPath} from '../lib/media.mjs';
const {row,collection,lang,index=0}=Astro.props;
const t=readJSON('src/data/ui.json')[lang];
---
<article class:list={['card',`card-${collection}`]} data-filter-item data-area={row.researchAreas.join(' ')} data-type={row.type||row.status||''} data-tags={row.tags.join('|')} data-text={`${l(row,'title',lang)} ${l(row,'summary',lang)} ${row.tags.map((tag:string)=>t['tag:'+tag]||tag).join(' ')}`.toLowerCase()}>
  <div class="card-top"><span class="mono">{String(index+1).padStart(2,'0')}</span><span class="badge">{l(row,'statusLabel',lang)?<Text record={row} field={`statusLabel_${lang}`} lang={lang}/>:t[row.type||row.status]||t[collection]}</span></div>
  {row.heroImage&&<img class="card-image" src={row.heroImage} alt={l(mediaForPath(row.heroImage)||{},'alt',lang)||l(row,'title',lang)} loading="lazy" />}
  <h3><a href={materialHref(row.eventCollection||collection,row,lang)}><Text record={row} field={`title_${lang}`} lang={lang}/></a></h3>
  {row.readingMode&&<p class="reading-mode">{t['reading:'+row.readingMode]}</p>}
  {row.date&&<time class="small muted" datetime={row.date}>{publicationDate(row,lang)}</time>}
  <p><Text record={row} field={`summary_${lang}`} lang={lang}/></p>
  <div class="card-bottom"><div class="tag-list">{row.tags.slice(0,3).map((tag:string)=><span>{t['tag:'+tag]||tag}</span>)}</div><span aria-hidden="true" class="card-arrow">↗</span></div>
</article>
