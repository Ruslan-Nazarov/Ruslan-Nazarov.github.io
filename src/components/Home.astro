---
import {site,readJSON,localize as l} from '../lib/content.mjs';
import Card from './Card.astro';
const {lang,data}=Astro.props;
const t=readJSON('src/data/ui.json')[lang],s=site[lang];
---
<section class="hero wrap">
  <div class="hero-content">
    <p class="eyebrow"><span class="status-dot"></span> {s.role}</p>
    <h1>{s.heroTitle}</h1>
    <p class="hero-description">{s.heroText}</p>
    <div class="hero-actions"><a class="button" href={`/${lang}/research/`}>{t.explore} <span>↗</span></a><a class="text-link" href={`/${lang}/projects/`}>{t.viewProjects} →</a></div>
    <p class="hero-method">{s.heroNote}</p>
  </div>
  <div class="research-notebook">
    <div class="notebook-top"><span class="mono">{t.notebook}</span><span>01 — 04</span></div>
    <div class="portrait-block">{site.portrait?<img src={site.portrait} alt={site.name}/>:<div class="monogram" aria-label={t.portrait}>rn<span>·</span></div>}<p>{site.name}<small>{s.role}</small></p></div>
    <div class="notebook-map">{data.research.map((r:any,i:number)=><a href={`/${lang}/research/${r.slug}/`}><span class="map-symbol">{r.symbol}</span><span>{l(r,'title',lang)}</span><small class="mono">0{i+1}</small></a>)}</div>
    <div class="notebook-bottom"><span class="status-dot"></span>{site.tagline}</div>
  </div>
</section>
<section class="section wrap">
  <div class="section-heading"><div><p class="eyebrow">01 / {t.research}</p><h2>{s.intro}</h2></div><a class="text-link" href={`/${lang}/research/`}>{t.research} ↗</a></div>
  <div class="research-grid">{data.research.map((r:any,i:number)=><a class="research-tile" href={`/${lang}/research/${r.slug}/`}><div class="research-tile-top"><span class="research-symbol">{r.symbol}</span><small class="mono">0{i+1}</small></div><h3>{l(r,'title',lang)}</h3><p>{l(r,'summary',lang)}</p><span class="tile-arrow" aria-hidden="true">↗</span></a>)}</div>
</section>
<section class="section section-tint"><div class="wrap">
  <div class="section-heading"><div><p class="eyebrow">02 / {t.projects}</p><h2>{s.featured}</h2></div><a class="text-link" href={`/${lang}/projects/`}>{t.allProjects} ↗</a></div>
  <div class="card-grid">{data.projects.filter((r:any)=>r.featured).map((row:any,index:number)=><Card row={row} collection="projects" lang={lang} index={index}/>)}</div>
  {data.projects.some((p:any)=>p.id==='mathematical-parser')&&<a class="graph-feature" href={`/${lang}/projects/mathematical-parser/graph/`}><div><p class="eyebrow">{t.graph}</p><h3>{t.openGraph}</h3><p>{t.graphDescription}</p></div><div class="mini-chain" aria-hidden="true"><span>+</span><i>→</i><span>×</span><i>→</i><span>xⁿ</span><i>↗</i></div></a>}
</div></section>
<section class="section wrap">
  <div class="section-heading"><div><p class="eyebrow">03 / {t.publications}</p><h2>{s.publications}</h2></div><a class="text-link" href={`/${lang}/publications/`}>{t.allPublications} ↗</a></div>
  <div class="publication-list">{data.publications.filter((r:any)=>r.featured).map((r:any,i:number)=><a href={`/${lang}/publications/${r.slug}/`} class="publication-row"><span class="publication-index mono">0{i+1}</span><div><span class="eyebrow">{t[r.type]}</span><h3>{l(r,'title',lang)}</h3><p>{l(r,'summary',lang)}</p></div><span class="row-arrow">↗</span></a>)}</div>
</section>
<section class="section wrap journal-section">
  <div class="section-heading"><div><p class="eyebrow">04 / {t.journal}</p><h2>{s.journal}</h2></div><a class="text-link" href={`/${lang}/journal/`}>{t.allJournal} ↗</a></div>
  {data.journal.length?<div class="card-grid">{data.journal.slice().sort((a:any,b:any)=>b.date.localeCompare(a.date)).slice(0,3).map((row:any)=><Card row={row} collection="journal" lang={lang}/>)}</div>:<div class="journal-empty"><span class="mono">2026 —</span><p>{s.journalEmpty}</p><a href={`/${lang}/rss.xml`}>RSS ↗</a></div>}
</section>
<section class="wrap"><div class="collaboration-block"><span class="eyebrow">{t.contact}</span><h2>{s.collaborationTitle}</h2><p>{s.collaborationText}</p><a class="button" href={`/${lang}/about/#contact`}>{t.contact} ↗</a></div></section>
