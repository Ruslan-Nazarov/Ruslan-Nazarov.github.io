---
import {site,localize as l,pathFor} from '../lib/content.mjs';
import {navigation} from '../lib/navigation.mjs';
import {articleCategory,publicationDate} from '../lib/article-categories.mjs';
interface Props {lang:'ru'|'en';data:Record<string,any[]>}
const {lang,data}=Astro.props;
const s=site[lang];
const articles=data.publications.filter((row:any)=>row.type==='article'&&row.readingMode==='full');
---
<section class="wrap simple-home">
  <div class="simple-intro">
    <div>
      <p class="eyebrow">{s.heroEyebrow}</p>
      <h1>{s.heroTitle}</h1>
      <p class="hero-description">{s.heroText}</p>
      <a class="text-link" href={`/${lang}/about/`}>{lang==='ru'?'Об авторе':'About the author'} →</a>
    </div>
  </div>
  <nav class="section-directory" aria-label={lang==='ru'?'Разделы сайта':'Site sections'}>
    {navigation.map(item=><a href={`/${lang}/${item.path}/`}><span>{item[lang]}</span><span aria-hidden="true">→</span></a>)}
  </nav>
  {articles.length>0&&<section class="home-articles">
    <div class="section-heading"><h2>{lang==='ru'?'Статьи':'Articles'}</h2><a class="text-link" href={`/${lang}/articles/`}>{lang==='ru'?'Все статьи':'All articles'} →</a></div>
    {articles.map((row:any)=><article class="simple-article">{articleCategory(row)&&<p class="small"><a href={`/${lang}/articles/#${row.articleCategory}`}>{articleCategory(row)![lang]}</a>{row.date&&<> · <time datetime={row.date.slice(0,7)}>{publicationDate(row,lang)}</time></>}</p>}<h3><a href={pathFor('publications',row,lang)}>{l(row,'title',lang)}</a></h3><p>{l(row,'summary',lang)}</p></article>)}
  </section>}
</section>
