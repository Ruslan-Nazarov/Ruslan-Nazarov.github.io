---
const {lang}=Astro.props as {lang:'ru'|'en'};
const ru=lang==='ru';
const steps=ru?['Исходный процесс и условия','Итерации с учётом предшествующего развития','Сравнение содержания и пути; выбор кандидата','Содержательная оценка и возможный обратный проход','Гипотеза противоречия и его разрешения']:['Initial process and conditions','Iterations using the preceding development','Compare content and path; select a candidate','Substantive assessment and an optional reverse pass','Hypotheses about contradiction and its resolution'];
---
<figure class="model" data-ai-algorithm-diagram={lang}>
  <figcaption>{ru?'Рабочая схема исследования':'Research workflow'}</figcaption>
  <ol>{steps.map((step,index)=><li><span aria-hidden="true">{index+1}</span>{step}</li>)}</ol>
  <p>{ru?'Оценки и предложения модели помогают исследователю; ближайший по метрике процесс остаётся кандидатом. Основания и открытые вопросы сохраняются.':'Model scores and proposals assist the researcher; the closest process by the metric remains a candidate. Reasons and open questions are recorded.'}</p>
</figure>
<style>
  .model{margin:32px 0;padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--paper);color:var(--ink)}
  figcaption{font-size:21px;font-weight:600;color:var(--ink);margin:0 0 18px}
  ol{list-style:none!important;margin:0!important;padding:0!important;display:grid;gap:10px}
  li{display:flex;align-items:center;gap:12px;margin:0!important;padding:10px 12px;background:var(--tint);border-radius:8px;line-height:1.45;font-size:16px}
  li span{display:grid;place-items:center;flex:0 0 28px;height:28px;border-radius:50%;background:var(--soft);color:var(--accent-ink);font-weight:600}
  p{margin:18px 0 0!important;padding-left:12px;border-left:3px solid var(--accent);font-size:15px;line-height:1.6;color:var(--muted)}
  @media(max-width:600px){.model{padding:18px 12px}li{font-size:15px}}
</style>
