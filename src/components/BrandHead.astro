---
import {site} from '../lib/content.mjs';
---
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" content="#EEECE0" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#12161C" media="(prefers-color-scheme: dark)" />
<link rel="icon" href={site.favicon} sizes="any" />
<link rel="icon" href="/icons/rn-favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/icons/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/icons/favicon-16x16.png" type="image/png" sizes="16x16" />
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
