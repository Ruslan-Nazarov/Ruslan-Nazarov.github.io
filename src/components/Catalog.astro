---
import Card from './Card.astro';
import ProjectCatalog from './ProjectCatalog.astro';
import {readJSON} from '../lib/content.mjs';
const {rows,collection,lang}=Astro.props;
const t=readJSON('src/data/ui.json')[lang];
---
<section data-catalog>
  {collection==='projects' ? <ProjectCatalog rows={rows} lang={lang}/> : <div class="card-grid">{rows.map((row:any,index:number)=><Card row={row} collection={collection} lang={lang} index={index}/>)}</div>}
  {!rows.length&&<p class="empty-state">{t.forthcoming}</p>}
</section>
