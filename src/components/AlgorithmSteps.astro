---
import algorithm from '../data/papanda-algorithm.json';
const {lang}=Astro.props as {lang:'ru'|'en'};
const copy=algorithm[lang];
---
<figure class="algorithm-diagram" data-algorithm-diagram={lang} aria-labelledby={`algorithm-title-${lang}`}>
  <figcaption id={`algorithm-title-${lang}`}>
    <strong>{lang==='ru'?'Как строится конспект в papanda':'Building a note in papanda'}</strong>
    <span>{lang==='ru'?'Шаги и подсказки ручного режима':'Steps and guidance from manual mode'}</span>
  </figcaption>
  <p class="algorithm-question">{copy.anchor}</p>
  <ol>
    {copy.steps.map((step,index)=><li>
      <span class="algorithm-number" aria-hidden="true">{index+1}</span>
      <div class="algorithm-card">
        <p class="algorithm-step-title">{step.title}</p>
        <p class="algorithm-prompt">{step.prompt}</p>
        {step.detail&&<p class="algorithm-detail">{step.detail}</p>}
      </div>
    </li>)}
  </ol>
</figure>
<style>
  .algorithm-diagram{margin:32px 0;padding:28px;background:#fff5ec;border:1px solid #e7d9cc;border-radius:18px;color:#1e293b}
  figcaption{display:flex;flex-direction:column;gap:6px;margin:0 0 22px;font-size:14px;color:#64748b;line-height:1.5}
  figcaption strong{font-size:23px;color:#1e293b;font-weight:600;line-height:1.35}
  .algorithm-question{margin:0 0 24px!important;padding:12px 16px;background:#fff3e0;border-left:3px solid #d87d2d;font-size:17px;font-weight:600}
  ol{list-style:none!important;margin:0!important;padding:0!important;counter-reset:none}
  li{position:relative;display:grid;grid-template-columns:34px minmax(0,1fr);gap:14px;padding:0 0 22px;margin:0!important}
  li:last-child{padding-bottom:0}
  li:not(:last-child)::before{content:'';position:absolute;left:16px;top:35px;bottom:0;border-left:2px solid #e0c8b3}
  li:not(:last-child)::after{content:'↓';position:absolute;bottom:0;left:9px;width:16px;text-align:center;font:18px/20px Arial,sans-serif;color:#a16b3c;background:#fff5ec}
  .algorithm-number{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;width:34px;height:34px;background:#f2994a;border-radius:50%;font:600 15px/1 Arial,sans-serif;color:#422209}
  .algorithm-card{padding:18px 20px;background:#fff;border:1px solid #e2e8f0;border-radius:12px;min-width:0}
  .algorithm-step-title{margin:0 0 10px!important;font-size:17px;line-height:1.4;font-weight:600;color:#934a17}
  .algorithm-prompt{margin:0!important;font-size:16px;line-height:1.65}
  .algorithm-detail{margin:12px 0 0!important;font-size:14px;line-height:1.65;color:#566476}
  @media(max-width:600px){.algorithm-diagram{padding:18px 12px;margin:24px 0}figcaption strong{font-size:20px}li{grid-template-columns:28px minmax(0,1fr);gap:9px}.algorithm-number{width:28px;height:28px;font-size:13px}li:not(:last-child)::before{left:13px;top:30px}li:not(:last-child)::after{left:6px}.algorithm-card{padding:14px 12px}.algorithm-step-title{font-size:16px}.algorithm-prompt{font-size:15px}.algorithm-detail{font-size:14px}}
</style>
