---
import {authorshipOf} from '../lib/authorship.mjs';
import {authorshipCopy} from '../lib/authorship-copy.mjs';
import {isAuthorshipField} from '../lib/authorship-fields.mjs';
const {record,field,lang}=Astro.props;
const state=isAuthorshipField(field)&&record?.[field]?.trim()?authorshipOf(record,field):null;
const label=state==='ai'?(lang==='ru'?'ИИ':'AI'):'✎';
const description=authorshipCopy(state,lang);
---
{state&&<span class="authorship-mark" role="button" tabindex="0" aria-label={description} aria-haspopup="dialog" aria-expanded="false" data-authorship={state} data-explanation={description} data-contact={`/${lang}/about/#contact`} data-pagefind-ignore>{label}</span>}
