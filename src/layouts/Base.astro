---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site, readJSON } from '../lib/content.mjs';
interface Props {lang:'ru'|'en';title:string;description?:string;path?:string;noindex?:boolean}
const { lang, title, description=site[lang].heroText, path='',noindex=false }=Astro.props;
const t=readJSON('src/data/ui.json')[lang];
const other=lang==='ru'?'en':'ru';
const url=new URL(`/${lang}/${path?path+'/':''}`,Astro.site);
const nav=['research','projects','publications','journal','timeline','about'];
const documentTitle=path?`${title} | ${site.name}`:`${site.name} | ${site[lang].role}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="ru" href={new URL(`/ru/${path?path+'/':''}`,Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en/${path?path+'/':''}`,Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(`/en/${path?path+'/':''}`,Astro.site)} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang==='ru'?'ru_RU':'en_US'} />
    <meta property="og:image" content={new URL('/images/social-card.svg',Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex&&<meta name="robots" content="noindex,follow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={t.rss} href={`/${lang}/rss.xml`} />
    <script is:inline>
      try{const theme=localStorage.getItem('rn-theme')||'system';document.documentElement.dataset.theme=theme;document.documentElement.classList.toggle('dark',theme==='dark'||theme==='system'&&matchMedia('(prefers-color-scheme: dark)').matches)}catch{}
    </script>
    {site.cloudflareToken&&<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:site.cloudflareToken})}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="brand" href={`/${lang}/`} aria-label={`${site.name} — ${t.home}`}><span class="brand-mark">rn<span>·</span></span><span>{site.name}<small>{site[lang].role}</small></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">{t.menu} ☰</button>
      <nav id="main-nav" aria-label={t.menu}>
        {nav.map(n=><a href={`/${lang}/${n}/`} aria-current={path.split('/')[0]===n?'page':undefined}>{t[n]}</a>)}
        <a class="search-link" href={`/${lang}/search/`} aria-label={t.search} title={t.search}><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg><span class="mobile-only">{t.search}</span></a>
      </nav>
      <div class="preferences">
        <a class="language-link" data-language={other} lang={other} hreflang={other} href={`/${other}/${path?path+'/':''}`} aria-label={other==='ru'?'Русский':'English'}>{other.toUpperCase()}</a>
        <label class="theme-control"><span class="sr-only">{t.theme}</span><select id="theme-select" aria-label={t.theme}><option value="system">◐ {t.system}</option><option value="light">☼ {t.light}</option><option value="dark">☾ {t.dark}</option></select></label>
      </div>
    </header>
    <main id="main" data-pagefind-body><slot /></main>
    <footer class="site-footer" data-pagefind-ignore>
      <div><a class="footer-name" href={`/${lang}/`}>{site.name}<span>·</span></a><p>{site.tagline}</p></div>
      <div class="footer-links"><a href={`/${lang}/legal/`}>{t.legal}</a><a href={`/${lang}/privacy/`}>{t.privacy}</a><a href={`/${lang}/rss.xml`}>RSS ↗</a><a href="https://github.com/Ruslan-Nazarov" rel="noopener noreferrer">GitHub ↗</a></div>
      <small>© {new Date().getUTCFullYear()} {site.name} · CC BY 4.0</small>
    </footer>
    <script>
      const themeSelect=document.querySelector<HTMLSelectElement>('#theme-select');
      const media=matchMedia('(prefers-color-scheme: dark)');
      const applyTheme=()=>{const theme=themeSelect?.value||'system';document.documentElement.dataset.theme=theme;document.documentElement.classList.toggle('dark',theme==='dark'||theme==='system'&&media.matches);};
      if(themeSelect){themeSelect.value=document.documentElement.dataset.theme||'system';themeSelect.addEventListener('change',()=>{try{localStorage.setItem('rn-theme',themeSelect.value)}catch{}applyTheme()})}
      media.addEventListener('change',applyTheme);
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(a=>a.addEventListener('click',()=>{try{localStorage.setItem('rn-language',a.dataset.language!)}catch{}}));
      const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');
      menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('#main-nav')?.classList.toggle('open',open)});
      document.addEventListener('keydown',e=>{if(e.key==='Escape'){menu?.setAttribute('aria-expanded','false');document.querySelector('#main-nav')?.classList.remove('open')}});
    </script>
  </body>
</html>
