---
import Text from '../components/Text.astro';
import BrandHead from '../components/BrandHead.astro';
import BrandMark from '../components/BrandMark.astro';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/simple.css';
import {navigation,activeNavigation} from '../lib/navigation.mjs';
import 'katex/dist/katex.min.css';
import { site, readJSON } from '../lib/content.mjs';
interface Props {lang:'ru'|'en';title:string;description?:string;path?:string;noindex?:boolean}
const { lang, title, description=site[lang].heroText, path='',noindex=false }=Astro.props;
const t=readJSON('src/data/ui.json')[lang];
const footerProfiles=site.profiles.filter((profile:any)=>['LinkedIn','Medium'].includes(profile.label));
const other=lang==='ru'?'en':'ru';
const url=new URL(`/${lang}/${path?path+'/':''}`,Astro.site);
const active=activeNavigation(path);
const documentTitle=path?`${title} | ${site[lang].brandName}`:`${site[lang].brandName} | ${site[lang].role}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <BrandHead />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="ru" href={new URL(`/ru/${path?path+'/':''}`,Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en/${path?path+'/':''}`,Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(path?`/en/${path}/`:'/',Astro.site)} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang==='ru'?'ru_RU':'en_US'} />
    <meta property="og:image" content={new URL(site.socialImage,Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site[lang].brandName} — ${site[lang].role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {(noindex||process.env.SITE_EDITOR_PREVIEW==='1')&&<meta name="robots" content="noindex,follow" />}
    {site.cloudflareToken&&<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:site.cloudflareToken})}></script>}
    {site.yandexMetricaId&&process.env.SITE_EDITOR_PREVIEW!=='1'&&<script is:inline defer src="/metrika.js" data-metrica-id={site.yandexMetricaId}></script>}
  </head>
  <body>
    {process.env.SITE_EDITOR_PREVIEW==='1'&&<div style="padding:10px 20px;background:#fff0c2;color:#312b12;text-align:center;font:14px system-ui" data-pagefind-ignore>{lang==='ru'?'Локальный предпросмотр · включает черновики':'Local preview · includes drafts'}</div>}
    <a class="skip-link" href="#main"><Text record={t} field="skip" lang={lang}/></a>
    <header class="site-header">
      <a class="brand" href={`/${lang}/`} aria-label={`${site[lang].brandName} — ${t.home}`}><BrandMark id="header-amber"/><span class="brand-text"><small><Text record={site[lang]} field="brandDescriptor" lang={lang}/></small></span></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav"><Text record={t} field="menu" lang={lang}/> ☰</button>
      <nav id="main-nav" aria-label={t.menu}>
        {navigation.map(item=><a href={`/${lang}/${item.path}/`} aria-current={active===item.path?'page':undefined}>{item[lang]}</a>)}
      </nav>
      <div class="preferences">
        <a class="header-search" href={`/${lang}/search/`} aria-current={path==='search'?'page':undefined}>{t.search}</a>
        <a class="language-link" data-language={other} lang={other} hreflang={other} href={`/${other}/${path?path+'/':''}`} aria-label={other==='ru'?'Русский':'English'}>{other.toUpperCase()}</a>
      </div>
    </header>
    <main id="main" tabindex="-1" data-pagefind-body data-pagefind-ignore={noindex||undefined}><slot /></main>
    <dialog id="media-viewer" aria-label={t.imageViewer} data-pagefind-ignore>
      <form method="dialog"><button autofocus aria-label={t.close}>{t.close} ×</button></form>
      <div class="media-viewer-scroll"><img alt=""/></div><p></p>
    </dialog>
    <footer class="site-footer" data-pagefind-ignore>
      <div><a class="footer-name" href={`/${lang}/`}><BrandMark id="footer-amber"/><Text record={site[lang]} field="brandName" lang={lang}/></a><p><Text record={site[lang]} field="brandDescriptor" lang={lang}/></p></div>
      <div class="footer-links"><a href={`/${lang}/search/`}>{t.search}</a><a href={`/${lang}/legal/`}><Text record={t} field="legal" lang={lang}/></a><a href={`/${lang}/privacy/`}><Text record={t} field="privacy" lang={lang}/></a><a href={site.footerGithubUrl} rel="noopener noreferrer">{t.footerGithub} ↗</a>
        <span class="footer-socials">
          {footerProfiles.map((profile:any)=><a class="footer-social-link" href={profile.url} rel="me noopener noreferrer" aria-label={profile.label} title={profile.label}>
            {profile.label==='LinkedIn'
              ?<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.4-.75 1.36-1.55 2.79-1.55 2.99 0 3.58 1.97 3.58 4.53v5.27Z"/></svg>
              :<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false"><ellipse cx="6.5" cy="12" rx="6.5" ry="6.5"/><ellipse cx="17" cy="12" rx="3.25" ry="6.15"/><ellipse cx="22.5" cy="12" rx="1.5" ry="5.5"/></svg>}
          </a>)}
        </span>
      </div>
      <small>© {new Date().getUTCFullYear()} <Text record={site[lang]} field="brandName" lang={lang}/> · {t.footerLicense}</small>
      <a class="back-to-top" href="#main"><Text record={t} field="backToTop" lang={lang}/> ↑</a>
    </footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(a=>a.addEventListener('click',()=>{try{localStorage.setItem('rn-language',a.dataset.language!)}catch{}}));
      const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');
      menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('#main-nav')?.classList.toggle('open',open)});
      document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu?.getAttribute('aria-expanded')==='true'){menu.setAttribute('aria-expanded','false');document.querySelector('#main-nav')?.classList.remove('open');menu.focus()}});
      const viewer=document.querySelector<HTMLDialogElement>('#media-viewer');
      document.querySelectorAll<HTMLAnchorElement>('[data-media-viewer],.prose a:has(> img)').forEach(link=>link.addEventListener('click',event=>{
        if(!viewer||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey||event.button!==0)return;
        if(!link.hasAttribute('data-media-viewer')&&!/\.(png|jpe?g|webp|gif|svg)(?:[?#]|$)/i.test(link.href))return;
        event.preventDefault();
        const img=link.querySelector('img'),target=viewer.querySelector('img')!;
        target.src=link.href;target.alt=img?.alt||'';
        viewer.querySelector('p')!.textContent=link.closest('figure')?.querySelector('figcaption')?.textContent||img?.alt||'';
        viewer.showModal();
      }));
      viewer?.addEventListener('click',event=>{if(event.target===viewer)viewer.close()});
    </script>
  </body>
</html>
